---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Image de partage (Open Graph / Twitter), 1200×630 recommandé. Chemin absolu depuis /public. */
  image?: string;
}

const {
  title,
  description = "Portfolio d'Alice Frelin, designeuse et développeuse frontend.",
  image = "/og-image.jpg",
} = Astro.props;

const urlCanonique = new URL(Astro.url.pathname, Astro.site);
const urlImage = new URL(image, Astro.site);
---

<html lang="fr" data-theme="portfolio">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph (partage LinkedIn, Facebook, Discord…) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:image" content={urlImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Alice Frelin — Portfolio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlImage} />
  </head>
  <body class="bg-base-100 font-manrope text-base-content antialiased">
    <a
      href="#contenu"
      class="sr-only rounded-full border border-noir bg-blanc px-4 py-2 font-manrope text-[0.9375rem] font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100]"
    >
      Aller au contenu
    </a>
    <slot />
    <!-- TODO : composant Footer -->
  </body>
</html>
