---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CardProjetL from "../components/CardProjetL.astro";
import SectionContact from "../components/SectionContact.astro";
import { pb, type Projet } from "../lib/pocketbase";

import porteCle from "../assets/img/accueil/porte_cle.png";
import boutonCoeur from "../assets/img/accueil/bouton_coeur.png";
import helloKitty from "../assets/img/accueil/hello_kitty.png";
import pince from "../assets/img/accueil/pince.png";
import chat from "../assets/img/accueil/chat.png";
import des from "../assets/img/accueil/des.png";
import dossier from "../assets/img/accueil/dossier.png";
import carteSd from "../assets/img/accueil/carte_sd.png";
import appareilPhoto from "../assets/img/accueil/appareil_photo_numerique.png";
import perlesDesign from "../assets/img/accueil/perles_i_love_design.png";
import perlesAlice from "../assets/img/accueil/perles_alice.png";
import tamagotchi from "../assets/img/accueil/tamagotchi.png";
import ds from "../assets/img/accueil/ds.png";
import telephone from "../assets/img/accueil/telephone_hello_kitty.png";
import cassette from "../assets/img/accueil/cassette.png";
import boutonRond from "../assets/img/accueil/bouton_rond.png";
import boutonEtoile from "../assets/img/accueil/bouton_etoile.png";

import iconeMontage from "../assets/img/accueil/competence_montage_video.png";
import iconeDesign from "../assets/img/accueil/competence_design.png";
import iconeIllustration from "../assets/img/accueil/competence_illustration.png";

// ===== Derniers projets (PocketBase, lecture publique) =====
let derniersProjets: Projet[] = [];
let erreur = false;
try {
  const resultat = await pb.collection("Projets").getList<Projet>(1, 3, { sort: "-Date" });
  derniersProjets = resultat.items;
} catch (e) {
  console.error("Impossible de récupérer les derniers projets :", e);
  erreur = true;
}

// ===== Stickers du haut de page =====
// Positions reprises de la maquette (cadre de 1440 × 1860 px), converties en % pour suivre la largeur.
const LARGEUR = 1440;
const HAUTEUR = 1860;
const stickers: { image: ImageMetadata; x: number; y: number; l: number }[] = [
  { image: pince, x: 631, y: 92, l: 177 },
  { image: appareilPhoto, x: 994, y: 128, l: 446 },
  { image: porteCle, x: 157, y: 167, l: 239 },
  { image: helloKitty, x: 491, y: 241, l: 104 },
  { image: carteSd, x: 863, y: 279, l: 96 },
  { image: boutonCoeur, x: 78, y: 484, l: 109 },
  { image: perlesDesign, x: 1090, y: 554, l: 327 },
  { image: chat, x: 44, y: 599, l: 385 },
  { image: dossier, x: 863, y: 675, l: 158 },
  { image: tamagotchi, x: 994, y: 675, l: 446 },
  { image: des, x: 578, y: 730, l: 140 },
  { image: perlesAlice, x: 515, y: 1025, l: 276 },
  { image: ds, x: 52, y: 1127, l: 485 },
  { image: boutonRond, x: 863, y: 1336, l: 76 },
  { image: cassette, x: 1028, y: 1347, l: 347 },
  { image: boutonEtoile, x: 740, y: 1374, l: 51 },
  { image: telephone, x: 600, y: 1578, l: 229 },
];
const pct = (valeur: number, total: number) => `${((valeur / total) * 100).toFixed(2)}%`;

// ===== Ce que je fais (liens vers la page Projets filtrée) =====
const competences = [
  { nom: "Montage-vidéo", image: iconeMontage },
  { nom: "Design", image: iconeDesign },
  { nom: "Illustration", image: iconeIllustration },
];
---

<Layout title="Alice Frelin — Portfolio">
  <Header />

  <main>
    <!-- ===== Hero : titre entouré de stickers ===== -->
    <div class="relative -mt-[78px] aspect-[1440/1860] w-full overflow-hidden">
      <div aria-hidden="true">
        {stickers.map(({ image, x, y, l }, i) => (
          <Image
            src={image}
            alt=""
            loading={y < 700 ? "eager" : "lazy"}
            class="sticker absolute h-auto"
            style={`left:${pct(x, LARGEUR)};top:${pct(y, HAUTEUR)};width:${pct(l, LARGEUR)};--delai:${(i % 5) * -1.3}s`}
          />
        ))}
      </div>

      <h1 class="absolute top-[22.3%] left-1/2 z-10 w-max -translate-x-1/2 text-center leading-[0.9]">
        <span class="block font-manrope text-[clamp(2.25rem,7.64vw,6.875rem)] font-extrabold tracking-[-0.02em] text-noir">
          Alice Frelin’s
        </span>
        <span class="block font-peix text-[clamp(3rem,10.4vw,9.375rem)] text-rose-vif [font-feature-settings:'liga'_0]">
          Archives
        </span>
      </h1>
    </div>

    <div class="mx-auto flex max-w-[1100px] flex-col gap-24 px-6 pt-12 pb-10 md:box-content md:gap-[150px] md:px-12">
      <!-- ===== Qui suis-je ? ===== -->
      <section aria-labelledby="titre-qui" class="flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-[704px]">
          <h2 id="titre-qui" class="text-section-title text-rose-vif">Qui suis-je ?</h2>
          <p class="mt-6 text-body-s">
            Étudiante en design et développement, je crée des identités visuelles, des interfaces et des expériences
            numériques qui allient esthétique et fonctionnalité.
          </p>
          <p class="mt-2.5 text-body-s">
            Passionnée par la typographie, le motion design et l'expérience utilisateur, disponible pour des projets
            freelance et collaborations.
          </p>
        </div>
        <a href="/a-propos" class="btn-pilule lg:mb-14">En savoir plus</a>
      </section>

      <!-- ===== Mes derniers projets ===== -->
      <section aria-labelledby="titre-derniers">
        <div class="flex flex-wrap items-center gap-x-10 gap-y-4">
          <h2 id="titre-derniers" class="text-titre-bold">Mes derniers projets</h2>
          <a href="/projets" class="btn-pilule">Tous les projets</a>
        </div>

        {erreur ? (
          <p role="alert" class="mt-10 text-body-s">Les projets n'ont pas pu être chargés. Réessayez dans quelques instants.</p>
        ) : derniersProjets.length === 0 ? (
          <p class="mt-10 text-body-s">Aucun projet pour le moment.</p>
        ) : (
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-[30px]">
            {derniersProjets.map((projet) => (
              <li><CardProjetL projet={projet} taille="grille" /></li>
            ))}
          </ul>
        )}
      </section>

      <!-- ===== Ce que je fais ===== -->
      <section aria-labelledby="titre-fais">
        <h2 id="titre-fais" class="text-titre-bold">Ce que je fais</h2>
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-[30px]">
          {competences.map(({ nom, image }) => (
            <li>
              <a
                href={`/projets?categorie=${encodeURIComponent(nom)}#tous-les-projets`}
                class="group flex aspect-[347/330] flex-col items-center justify-center gap-4 border-8 border-rose-vif bg-blanc p-6
                       transition hover:-translate-y-1 hover:bg-rose-pastel hover:shadow-card motion-reduce:transition-none"
              >
                <Image
                  src={image}
                  alt=""
                  class="h-[65%] w-auto object-contain [image-rendering:pixelated] transition-transform group-hover:scale-105"
                />
                <span class="text-body-m">{nom}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <SectionContact
      titre="Un projet en tête ?"
      texte="Discutons de vos besoins et créons ensemble quelque chose d'unique."
    />
  </main>

  <Footer />
</Layout>

<style>
  /* Les stickers flottent doucement (désactivé si l'utilisateur réduit les animations) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.sticker) {
      animation: flotter 6s ease-in-out infinite;
      animation-delay: var(--delai);
    }
  }
  @keyframes flotter {
    0%,
    100% {
      translate: 0 0;
      rotate: 0deg;
    }
    50% {
      translate: 0 -8px;
      rotate: 1.5deg;
    }
  }
</style>
