---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { pb, urlFichier, paragraphes, type Projet } from "../../lib/pocketbase";
import flecheCercle from "../../assets/svg/fleche_cercle.svg";
import croix from "../../assets/img/bouton_croix_pixel.svg";

const { id = "" } = Astro.params;

let projet: Projet | null = null;
let erreur = false;
let precedent: Pick<Projet, "id" | "Titre"> | undefined;
let suivant: Pick<Projet, "id" | "Titre"> | undefined;

try {
  // Liste légère (id + titre) pour les liens précédent / suivant, même ordre que la page Projets
  const liste = await pb
    .collection("Projets")
    .getFullList<Projet>({ sort: "-Date", fields: "id,Titre" });
  const index = liste.findIndex((p) => p.id === id);

  if (index !== -1) {
    projet = await pb.collection("Projets").getOne<Projet>(id);
    if (liste.length > 1) {
      precedent = liste[(index - 1 + liste.length) % liste.length];
      suivant = liste[(index + 1) % liste.length];
    }
  }
} catch (e) {
  console.error("Impossible de récupérer le projet :", e);
  erreur = true;
}

if (!projet && !erreur) return Astro.rewrite("/404");
if (erreur) Astro.response.status = 503;

const sections = projet
  ? [
      { titre: "Le défi", texte: paragraphes(projet.defi) },
      { titre: "Ma solution", texte: paragraphes(projet.solution) },
    ].filter((s) => s.texte.length > 0)
  : [];

// Une vidéo dans la galerie (détectée par extension) est mise en avant, à part des photos
const estVideo = (nom: string) => /\.(mp4|webm|mov|m4v)$/i.test(nom);
const galerieVideos = projet ? projet.Galerie.filter(estVideo) : [];
const galeriePhotos = projet ? projet.Galerie.filter((g) => !estVideo(g)) : [];
const urlsGaleriePhotos = projet ? galeriePhotos.map((g) => urlFichier(projet!, g)) : [];
---

<Layout
  title={projet ? `${projet.Titre} — Alice Frelin` : "Projet — Alice Frelin"}
  description={projet?.Sous_titres}
>
  <Header />

  {erreur || !projet ? (
    <main class="mx-auto max-w-[1100px] px-6 py-32">
      <h1 class="text-section-title text-rose-vif">Oups</h1>
      <p role="alert" class="mt-6 text-body-m">Ce projet n'a pas pu être chargé. Réessayez dans quelques instants.</p>
      <a href="/projets" class="btn-pilule mt-10">Retour aux projets</a>
    </main>
  ) : (
    <main>
      <!-- ===== Bande titre ===== -->
      <div class="-mt-[78px] bg-bleu-vif px-4 pt-20 pb-5 sm:pt-[110px] sm:pb-6 md:px-[38px] md:pt-[150px] md:pb-8">
        <h1 class="text-banniere max-w-[1186px] [--taille-banniere:clamp(3.5rem,13.9vw,12.5rem)] text-blanc">{projet.Titre}</h1>
        <div class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-1 md:mt-6 md:pl-[13px]">
          <p class="font-peix text-[1.75rem] leading-none tracking-[-0.09em] text-noir [font-feature-settings:'liga'_0] md:text-[2.5rem]">
            {projet.Categorie.join(" - ")}
          </p>
          <p class="text-body-s text-blanc">{projet.Sous_titres}</p>
        </div>
      </div>

      <!-- ===== Visuel principal ===== -->
      {projet.Miniature && (
        <img
          src={urlFichier(projet, projet.Miniature)}
          alt=""
          class="h-[260px] w-full object-cover md:h-[486px]"
          fetchpriority="high"
        />
      )}

      <div class="mx-auto max-w-[1100px] px-6 py-14 md:box-content md:px-12 md:py-10">
        <!-- ===== À propos ===== -->
        <section aria-labelledby="titre-a-propos">
          <h2 id="titre-a-propos" class="text-section-title text-rose-vif">À propos du projet</h2>
          <div class="mt-6 flex flex-col gap-[1em] text-body-m">
            {paragraphes(projet.a_propos).map((p) => <p>{p}</p>)}
          </div>
          {projet.Client && (
            <p class="mt-6 text-body-s"><strong class="font-bold">Cadre</strong> : {projet.Client}</p>
          )}
        </section>

        <!-- ===== Défi / solution ===== -->
        {sections.length > 0 && (
          <div class="mt-16 grid gap-12 md:mt-24 md:grid-cols-2 md:gap-[178px]">
            {sections.map((s) => (
              <section>
                <h2 class="text-titre-bold">{s.titre}</h2>
                <div class="mt-6 flex flex-col gap-3 text-body-s">
                  {s.texte.map((p) => <p>{p}</p>)}
                </div>
              </section>
            ))}
          </div>
        )}

        <!-- ===== Logiciels ===== -->
        {projet.Logiciels.length > 0 && (
          <ul aria-label="Logiciels utilisés" class="mt-14 flex flex-wrap gap-5">
            {projet.Logiciels.map((logiciel) => (
              <li class="border border-noir bg-bleu-vif px-6 py-3 font-manrope text-[1.125rem] leading-[1.625rem] font-semibold text-blanc">
                {logiciel}
              </li>
            ))}
          </ul>
        )}

        <!-- ===== Galerie ===== -->
        {projet.Galerie.length > 0 && (
          <section aria-labelledby="titre-galerie" class="mt-20 md:mt-[120px]">
            <h2 id="titre-galerie" class="text-titre-bold">Galerie</h2>

            <!-- Vidéo(s) : mise(s) en avant, en premier et en grand -->
            {galerieVideos.length > 0 && (
              <div class="mt-8 flex flex-col gap-8">
                {galerieVideos.map((video) => (
                  <video
                    src={urlFichier(projet, video)}
                    controls
                    preload="metadata"
                    class="h-auto w-full border border-noir shadow-card"
                  />
                ))}
              </div>
            )}

            <!-- Photos : façon Pinterest, on clique pour agrandir -->
            {galeriePhotos.length > 0 && (
              <ul
                aria-label="Photos du projet"
                data-galerie-photos
                class="mt-8 columns-1 gap-6 sm:columns-2 lg:columns-3"
              >
                {galeriePhotos.map((image, i) => (
                  <li class="mb-6 break-inside-avoid">
                    <button
                      type="button"
                      data-index={i}
                      aria-label={`Agrandir la photo ${i + 1}`}
                      class="block w-full cursor-zoom-in transition hover:opacity-90 focus-visible:opacity-90"
                    >
                      <img
                        src={urlFichier(projet, image)}
                        alt={`${projet.Titre} — photo ${i + 1}`}
                        loading="lazy"
                        decoding="async"
                        class="h-auto w-full border border-noir"
                      />
                    </button>
                  </li>
                ))}
              </ul>
            )}

            <!-- Visionneuse plein écran -->
            {galeriePhotos.length > 0 && (
              <dialog id="visionneuse-galerie" class="modal" aria-label="Photo en grand">
                <div class="modal-box relative flex max-w-[92vw] items-center justify-center bg-transparent p-0 shadow-none">
                  <form method="dialog">
                    <button
                      aria-label="Fermer"
                      class="absolute top-3 right-3 z-10 cursor-pointer rounded-full bg-blanc/90 p-1 transition hover:scale-110"
                    >
                      <Image src={croix} alt="" class="size-8" />
                    </button>
                  </form>

                  {galeriePhotos.length > 1 && (
                    <button
                      type="button"
                      data-visionneuse-precedent
                      aria-label="Photo précédente"
                      class="absolute left-2 z-10 rounded-full bg-blanc/90 p-2 transition hover:scale-110 md:-left-16"
                    >
                      <Image src={flecheCercle} alt="" class="size-6" />
                    </button>
                  )}

                  <img data-visionneuse-image alt="" class="max-h-[80vh] w-auto max-w-full object-contain" />

                  {galeriePhotos.length > 1 && (
                    <button
                      type="button"
                      data-visionneuse-suivant
                      aria-label="Photo suivante"
                      class="absolute right-2 z-10 rounded-full bg-blanc/90 p-2 transition hover:scale-110 md:-right-16"
                    >
                      <Image src={flecheCercle} alt="" class="size-6 rotate-180" />
                    </button>
                  )}
                </div>
                <form method="dialog" class="modal-backdrop">
                  <button>Fermer</button>
                </form>
              </dialog>
            )}
          </section>
        )}

        <!-- ===== Précédent / suivant ===== -->
        {precedent && suivant && (
          <nav aria-label="Autres projets" class="mt-24 flex flex-wrap justify-between gap-8 md:mt-[200px]">
            <a href={`/projets/${precedent.id}`} rel="prev" class="group flex flex-col gap-3">
              <span class="flex items-center gap-3 font-manrope text-[1.25rem] font-medium tracking-[0.03em] md:text-[1.5rem]">
                <Image src={flecheCercle} alt="" class="size-5 transition-transform group-hover:-translate-x-1" />
                Projet précédent
              </span>
              <span class="font-manrope text-[1.25rem] font-extrabold group-hover:underline md:text-[1.5rem]">{precedent.Titre}</span>
            </a>
            <a href={`/projets/${suivant.id}`} rel="next" class="group ml-auto flex flex-col items-end gap-3 text-right">
              <span class="flex items-center gap-3 font-manrope text-[1.25rem] font-medium tracking-[0.03em] md:text-[1.5rem]">
                Suivant
                <Image src={flecheCercle} alt="" class="size-5 rotate-180 transition-transform group-hover:translate-x-1" />
              </span>
              <span class="font-manrope text-[1.25rem] font-extrabold group-hover:underline md:text-[1.5rem]">{suivant.Titre}</span>
            </a>
          </nav>
        )}
      </div>
    </main>
  )}

  <Footer />
</Layout>

<script define:vars={{ urlsGaleriePhotos }}>
  // ===== Galerie façon Pinterest : visionneuse plein écran avec navigation =====
  const visionneuse = document.querySelector("#visionneuse-galerie");
  const imageAffichee = visionneuse?.querySelector("[data-visionneuse-image]");

  if (visionneuse && imageAffichee && urlsGaleriePhotos.length > 0) {
    let indexActuel = 0;

    const afficher = () => {
      imageAffichee.src = urlsGaleriePhotos[indexActuel];
    };

    document.querySelectorAll("[data-galerie-photos] button[data-index]").forEach((bouton) => {
      bouton.addEventListener("click", () => {
        indexActuel = Number(bouton.dataset.index);
        afficher();
        visionneuse.showModal();
      });
    });

    visionneuse.querySelector("[data-visionneuse-precedent]")?.addEventListener("click", () => {
      indexActuel = (indexActuel - 1 + urlsGaleriePhotos.length) % urlsGaleriePhotos.length;
      afficher();
    });
    visionneuse.querySelector("[data-visionneuse-suivant]")?.addEventListener("click", () => {
      indexActuel = (indexActuel + 1) % urlsGaleriePhotos.length;
      afficher();
    });

    visionneuse.addEventListener("keydown", (evenement) => {
      if (evenement.key === "ArrowLeft") visionneuse.querySelector("[data-visionneuse-precedent]")?.dispatchEvent(new Event("click"));
      if (evenement.key === "ArrowRight") visionneuse.querySelector("[data-visionneuse-suivant]")?.dispatchEvent(new Event("click"));
    });
  }
</script>
