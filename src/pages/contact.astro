---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banniere from "../components/Banniere.astro";

import appareilPhoto from "../assets/img/objets_appareil_photo.webp";
import ordinateur from "../assets/img/contact/ordinateur_pixel.png";
import linkedin from "../assets/img/contact/linkedin_bleu.svg";
import behance from "../assets/img/contact/behance_bleu.svg";
import enveloppe from "../assets/svg/enveloppe_pixel.svg";

const reseaux = [
  { nom: "LinkedIn", href: "https://www.linkedin.com/in/alice-frelin-7a0184337", icone: linkedin, classe: "size-[72px] md:size-[99px]", externe: true },
  { nom: "Behance", href: "https://www.behance.net/alicefrelin2", icone: behance, classe: "h-[46px] w-[72px] md:h-[63px] md:w-[99px]", externe: true },
  { nom: "E-mail", href: "mailto:alicefrelin.pro@gmail.com", icone: enveloppe, classe: "size-[72px] md:size-[99px]", externe: false },
];
---

<Layout title="Contact — Alice Frelin">
  <Header />
  <Banniere titre="Contact" />

  <!-- ===== Bandeau défilant façon vieux site des années 2000 ===== -->
  <div class="overflow-hidden border-y border-noir bg-rose-pastel py-2.5" aria-hidden="true">
    <div data-marquee class="flex w-max gap-8 whitespace-nowrap font-manrope text-[0.9375rem] font-bold text-noir">
      <span class="flex items-center gap-8">
        ⋆｡‧˚ʚ merci de passer par ici ɞ˚‧｡⋆ &nbsp; n'hésite pas à laisser un message &nbsp; ⋆｡‧˚ʚ à très vite ɞ˚‧｡⋆ &nbsp; ✧
        disponible pour un stage ✧
      </span>
      <span class="flex items-center gap-8" aria-hidden="true">
        ⋆｡‧˚ʚ merci de passer par ici ɞ˚‧｡⋆ &nbsp; n'hésite pas à laisser un message &nbsp; ⋆｡‧˚ʚ à très vite ɞ˚‧｡⋆ &nbsp; ✧
        disponible pour un stage ✧
      </span>
    </div>
  </div>

  <main class="relative overflow-x-clip pb-32">
    <p class="mx-auto max-w-[1100px] px-6 pt-20 text-body-m md:box-content md:px-12 md:pt-24">
      Étudiante en BUT MMI (Métiers du Multimédia et de l'Internet), je recherche un <strong>stage</strong> en
      <strong> graphisme ou communication visuelle.</strong> Discutons ensemble de vos besoins et de la façon dont je peux
      contribuer à vos projets créatifs.
    </p>

    <div class="relative mx-auto mt-20 flex max-w-[1440px] flex-col items-center gap-14 px-6 md:mt-28 md:gap-16">
      <!-- Décors pixel art (cachés sur petit écran pour ne pas gêner le contenu) -->
      <Image
        src={appareilPhoto}
        alt=""
        class="pointer-events-none absolute top-0 left-[30px] hidden w-[27%] max-w-[393px] rotate-[15deg] [image-rendering:pixelated] lg:block"
      />
      <Image
        src={ordinateur}
        alt=""
        class="pointer-events-none absolute top-[15px] right-0 hidden w-[12%] max-w-[173px] [image-rendering:pixelated] lg:block"
      />

      <h2 class="text-section-title text-rose-vif">Contactez-moi</h2>

      <ul class="flex items-center gap-10 md:gap-14">
        {reseaux.map(({ nom, href, icone, classe, externe }) => (
          <li>
            <a
              href={href}
              aria-label={externe ? `${nom} (nouvel onglet)` : nom}
              target={externe ? "_blank" : undefined}
              rel={externe ? "noopener" : undefined}
              data-reseau
              class="block transition hover:-translate-y-1 hover:opacity-80 motion-reduce:transition-none"
            >
              <Image src={icone} alt="" class={classe} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-marquee] {
      animation: defiler 22s linear infinite;
    }
    [data-marquee]:hover {
      animation-play-state: paused;
    }
  }
  @keyframes defiler {
    to {
      transform: translateX(-50%);
    }
  }
</style>

<script>
  // ===== Petits cœurs / étoiles roses (GSAP) au survol d'un réseau social, + curseur scintillant =====
  import { gsap } from "gsap";

  const reduitAnimations = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  // Vrais glyphes de texte (pas des emojis en couleur) pour qu'ils héritent bien du rose du site
  const symboles = ["♥", "✦", "✧"];

  /** Fait éclater quelques cœurs/étoiles roses depuis le centre de `element` */
  const exploser = (element: Element, nombre: number) => {
    const rect = element.getBoundingClientRect();
    const depart = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };

    for (let i = 0; i < nombre; i++) {
      const particule = document.createElement("span");
      particule.textContent = symboles[Math.floor(Math.random() * symboles.length)];
      particule.setAttribute("aria-hidden", "true");
      particule.style.cssText = `position:fixed;left:${depart.x}px;top:${depart.y}px;z-index:60;
        pointer-events:none;font-size:${14 + Math.random() * 12}px;color:var(--color-rose-vif);translate:-50% -50%;`;
      document.body.appendChild(particule);

      // Trajectoire en arc, un peu différente à chaque fois
      const angle = ((Math.random() * 90 - 45) * Math.PI) / 180;
      const distance = 60 + Math.random() * 55;
      const dx = Math.sin(angle) * distance;
      const dy = -Math.cos(angle) * distance - 25;
      const rotation = (Math.random() > 0.5 ? 1 : -1) * (40 + Math.random() * 80);
      const delai = i * 0.04;

      gsap
        .timeline({ delay: delai, onComplete: () => particule.remove() })
        .fromTo(particule, { scale: 0, opacity: 1 }, { scale: 1, duration: 0.25, ease: "back.out(3)" }, 0)
        .to(particule, { x: dx, rotation, duration: 0.8, ease: "power1.out" }, 0)
        .to(particule, { y: dy, duration: 0.8, ease: "power2.out" }, 0)
        .to(particule, { opacity: 0, duration: 0.3, ease: "power1.in" }, 0.5);
    }
  };

  if (!reduitAnimations) {
    document.querySelectorAll<HTMLAnchorElement>("[data-reseau]").forEach((lien) => {
      lien.addEventListener("pointerenter", () => exploser(lien, 4));
    });

    // ===== Curseur scintillant : une petite étoile rose suit la souris avec un léger retard =====
    if (window.matchMedia("(pointer: fine)").matches) {
      const curseur = document.createElement("span");
      curseur.textContent = "✦";
      curseur.setAttribute("aria-hidden", "true");
      curseur.style.cssText = `position:fixed;top:0;left:0;z-index:70;pointer-events:none;
        font-size:1.375rem;color:var(--color-rose-vif);translate:-50% -50%;opacity:0;`;
      document.body.appendChild(curseur);

      const suivreX = gsap.quickTo(curseur, "x", { duration: 0.45, ease: "power3" });
      const suivreY = gsap.quickTo(curseur, "y", { duration: 0.45, ease: "power3" });

      window.addEventListener("pointermove", (evenement) => {
        suivreX(evenement.clientX);
        suivreY(evenement.clientY);
        gsap.to(curseur, { opacity: 1, rotation: "+=25", duration: 0.4, ease: "none" });
      });
      window.addEventListener("pointerleave", () => gsap.to(curseur, { opacity: 0, duration: 0.3 }));
    }
  }
</script>
