---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import fond from "../assets/img/apropos_background.webp";
import avatar from "../assets/img/apropos_avatar.webp";
import coeurBouton from "../assets/img/contact/figma/coeur_bouton.svg";
import coeurTitre from "../assets/img/contact/figma/coeur_titre.svg";
import coeurStatut from "../assets/img/contact/figma/coeur_statut.svg";
import coeurEtiquette from "../assets/img/contact/figma/coeur_etiquette.svg";
import iconeReduire from "../assets/img/contact/figma/icone_reduire.svg";
import iconeAgrandir from "../assets/img/contact/figma/icone_agrandir.svg";
import iconeFermer from "../assets/img/contact/figma/icone_fermer.svg";
import iconeUtilisatrice from "../assets/img/contact/figma/icone_utilisatrice.svg";
import chevron from "../assets/img/contact/figma/chevron.svg";
import poignee from "../assets/img/contact/figma/poignee.svg";
import camera from "../assets/img/contact/figma/camera.svg";
import motifPois from "../assets/img/contact/figma/motif_pois.svg";
import batterie from "../assets/img/contact/figma/batterie.svg";
import boutonHome from "../assets/img/contact/figma/bouton_home.svg";
import porteClesCoeur from "../assets/img/contact/figma/porte_cles_coeur.svg";
import refletPorteCles from "../assets/img/contact/figma/reflet_porte_cles.svg";
import etincelle1 from "../assets/img/contact/figma/etincelle1.svg";
import etincelle2 from "../assets/img/contact/figma/etincelle2.svg";
import etincelle3 from "../assets/img/contact/figma/etincelle3.svg";
import etincelle4 from "../assets/img/contact/figma/etincelle4.svg";
import etincelle5 from "../assets/img/contact/figma/etincelle5.svg";

const EMAIL = "alicefrelin.pro@gmail.com";
const reseaux = [
  { nom: "LinkedIn", href: "https://www.linkedin.com/in/alice-frelin-7a0184337", externe: true },
  { nom: "Behance", href: "https://www.behance.net/alicefrelin2", externe: true },
  { nom: "E-mail", href: `mailto:${EMAIL}`, externe: false },
];

const etincelles = [
  { src: etincelle1, classe: "top-[14%] left-[29%] size-5" },
  { src: etincelle2, classe: "top-[20%] right-[6%] size-6" },
  { src: etincelle3, classe: "top-[52%] left-[1%] size-5" },
  { src: etincelle4, classe: "top-[62%] left-[26%] size-4" },
  { src: etincelle5, classe: "top-[82%] right-[10%] size-5" },
];
---

<Layout title="Contact — Alice Frelin">
  <div class="relative isolate flex flex-col overflow-x-clip xl:min-h-svh">
    <!-- Fond à pois, décoratif : couvre tout le hero (header compris) -->
    <Image
      src={fond}
      alt=""
      width={1920}
      loading="eager"
      class="pointer-events-none absolute inset-0 -z-10 size-full object-cover"
    />
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 hidden xl:block">
      {etincelles.map(({ src, classe }) => <Image src={src} alt="" class={`absolute ${classe}`} />)}
    </div>

    <Header />

    <main class="relative pt-10 pb-16 sm:pt-16 md:pt-20 xl:flex xl:min-h-0 xl:flex-1 xl:flex-col xl:justify-center xl:py-6">
      <h1 class="mx-auto max-w-[900px] px-6 text-center font-peix text-[2.75rem] leading-none tracking-[-0.09em] text-rose-vif [font-feature-settings:'liga'_0] sm:text-[3.5rem] xl:text-[4.5rem]">
        Contactez-moi
      </h1>

      <div class="relative mx-auto mt-8 flex max-w-[1440px] flex-col items-center gap-10 px-4 sm:mt-10 sm:gap-16 sm:px-6 md:px-12 xl:mt-4 xl:w-full xl:max-w-none xl:flex-row xl:items-start xl:justify-between xl:gap-10 xl:mx-0 xl:px-16 2xl:px-24">
      <!-- ===== Réseaux mobile : juste les boutons liens, avant le formulaire (le mockup téléphone est réservé au desktop) ===== -->
      <div class="flex w-full max-w-[420px] flex-col items-center gap-4 xl:hidden">
        <p class="font-peix text-[1.75rem] text-rose-vif [font-feature-settings:'liga'_0]">Mes réseaux</p>
        <ul class="flex w-full flex-col items-center gap-3">
          {reseaux.map(({ nom, href, externe }) => (
            <li class="w-full">
              <a
                href={href}
                target={externe ? "_blank" : undefined}
                rel={externe ? "noopener" : undefined}
                data-reseau
                class="flex h-14 w-full items-center justify-between rounded-full border-[2.5px] border-[#f3a9c9] bg-gradient-to-b from-[#fffdf8] to-[#ffe6d9] px-4 shadow-[0_3px_0_0_rgba(216,138,176,0.6)] transition hover:scale-[1.03] active:scale-[0.97]"
              >
                <Image src={coeurBouton} alt="" class="size-[22px]" />
                <span class="font-manrope text-[1rem] font-bold text-[#c2367f]">{nom}</span>
                <Image src={coeurBouton} alt="" class="size-[22px]" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- ===== Colonne avatar (décorative, desktop uniquement) ===== -->
      <div class="relative hidden w-[300px] shrink-0 xl:block">
        <div class="relative mx-auto h-[500px] w-[240px]">
          <Image src={avatar} alt="Illustration d'Alice" width={480} class="h-full w-full object-contain object-bottom" />
        </div>

        <div class="mt-3 flex w-max items-center gap-2 rounded-2xl border-3 border-white bg-gradient-to-b from-[#6fe6ee] to-bleu-vif py-1.5 pr-5 pl-5 shadow-[0_3px_0_0_rgba(26,154,163,0.5)]">
          <span class="font-pixel text-[1.375rem] text-blanc">Alice</span>
          <Image src={coeurEtiquette} alt="" class="size-[18px]" />
        </div>

        <!-- Bulle de dialogue -->
        <div class="-mt-3 flex flex-col gap-0 rounded-[26px] border-3 border-bleu-vif bg-gradient-to-b from-white to-[#ffe3f0] px-7 pt-7 pb-6 text-center font-manrope text-[1.125rem] font-semibold text-[#8a5a6e] shadow-card">
          <p>Une idée, un stage, une collab' ?</p>
          <p>Écris-moi, je réponds vite !</p>
        </div>
      </div>

      <!-- ===== Colonne centrale : fenêtre "nouveau message" ===== -->
      <div class="flex w-full max-w-[760px] flex-col items-center gap-10 xl:gap-4">
        <div class="w-full overflow-hidden rounded-xl border-[1.5px] border-marron bg-gradient-to-b from-rose-pastel to-rose-vif/30 p-2 shadow-card">
          <!-- Barre de titre -->
          <div class="flex items-center justify-between rounded-md bg-gradient-to-b from-rose-pastel to-rose-vif/50 py-1.5 pr-1.5 pl-2.5 xl:py-1">
            <div class="flex items-center gap-2">
              <Image src={coeurTitre} alt="" class="size-[18px]" />
              <span class="font-pixel text-[1.125rem] text-marron">nouveau_message.txt</span>
            </div>
            <div aria-hidden="true" class="hidden items-center gap-1 sm:flex">
              <span class="flex h-[26px] w-[34px] items-center justify-center rounded border border-[#8f8a8d] bg-gradient-to-b from-white to-[#e3dde1]">
                <Image src={iconeReduire} alt="" class="size-3" />
              </span>
              <span class="flex h-[26px] w-[34px] items-center justify-center rounded border border-[#8f8a8d] bg-gradient-to-b from-white to-[#e3dde1]">
                <Image src={iconeAgrandir} alt="" class="size-3" />
              </span>
              <span class="flex h-[26px] w-[34px] items-center justify-center rounded border border-[#8e2b20] bg-gradient-to-b from-[#f39183] to-[#c9402f]">
                <Image src={iconeFermer} alt="" class="size-3" />
              </span>
            </div>
          </div>

          <!-- Contenu -->
          <div class="flex flex-col gap-4 border border-marron/40 bg-[#f3f0f1] px-4 pt-5 pb-5 sm:gap-5 sm:px-6 sm:pt-6 sm:pb-7">
            <div class="hidden items-center gap-3 sm:flex">
              <span class="font-pixel text-[1.25rem] text-marron">À :</span>
              <span class="flex items-center gap-2 rounded-full border-[1.5px] border-marron/40 bg-gradient-to-b from-blanc to-rose-pastel py-1.5 pr-5 pl-2.5">
                <Image src={iconeUtilisatrice} alt="" class="size-7" />
                <span class="font-pixel text-[1.1875rem] text-marron">alice_frelin.jpg</span>
              </span>
            </div>

            <p class="hidden font-pixel text-[1.125rem] leading-snug text-marron sm:block">
              ( &lt;3 ) graphiste &amp; développeuse front<br />
              (99%) de chances qu'on s'entende bien
            </p>

            <form id="formulaire-contact" class="flex flex-col gap-4" novalidate>
              <!-- Honeypot anti-spam : invisible pour un humain, souvent rempli par les bots -->
              <input
                type="text"
                name="piege"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                class="absolute -left-[9999px]"
              />

              <div class="flex flex-col gap-3.5 sm:flex-row">
                <div class="flex flex-1 flex-col gap-1.5">
                  <label for="nom" class="font-pixel text-[1.0625rem] text-marron">Nom</label>
                  <input
                    id="nom"
                    name="nom"
                    type="text"
                    required
                    autocomplete="name"
                    placeholder="Ton prénom et nom"
                    class="h-12 rounded-xl border-2 border-rose-vif/50 bg-white px-4 font-manrope text-[0.9375rem] text-marron shadow-[inset_0_2px_3px_0_rgba(140,77,107,0.15)] outline-none placeholder:text-marron/50 focus-visible:border-rose-vif"
                  />
                </div>
                <div class="flex flex-1 flex-col gap-1.5">
                  <label for="email" class="font-pixel text-[1.0625rem] text-marron">E-mail</label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    autocomplete="email"
                    placeholder="ton@email.fr"
                    class="h-12 rounded-xl border-2 border-rose-vif/50 bg-white px-4 font-manrope text-[0.9375rem] text-marron shadow-[inset_0_2px_3px_0_rgba(140,77,107,0.15)] outline-none placeholder:text-marron/50 focus-visible:border-rose-vif"
                  />
                </div>
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="sujet" class="font-pixel text-[1.0625rem] text-marron">Sujet</label>
                <div class="flex h-12 items-center gap-2 rounded-xl border-2 border-rose-vif/50 bg-white pr-2 pl-4 shadow-[inset_0_2px_3px_0_rgba(140,77,107,0.15)] has-[:focus-visible]:border-rose-vif">
                  <input
                    id="sujet"
                    name="sujet"
                    type="text"
                    required
                    placeholder="Stage, projet, collab' ou juste un coucou…"
                    class="min-w-0 flex-1 bg-transparent font-manrope text-[0.9375rem] text-marron outline-none placeholder:text-marron/50"
                  />
                  <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-gradient-to-b from-rose-pastel to-rose-vif" aria-hidden="true">
                    <Image src={chevron} alt="" class="size-4" />
                  </span>
                </div>
              </div>

              <div class="flex flex-col gap-1.5">
                <label for="message" class="font-pixel text-[1.0625rem] text-marron">Message</label>
                <div class="relative rounded-xl border-2 border-rose-vif/50 bg-white px-4 py-3.5 shadow-[inset_0_2px_3px_0_rgba(140,77,107,0.15)] has-[:focus-visible]:border-rose-vif">
                  <textarea
                    id="message"
                    name="message"
                    required
                    rows="4"
                    placeholder="Écris ton message ici…"
                    class="w-full resize-none bg-transparent font-manrope text-[0.9375rem] text-marron outline-none placeholder:text-marron/50"
                  ></textarea>
                  <Image src={poignee} alt="" class="pointer-events-none absolute right-2 bottom-2 size-3.5" aria-hidden="true" />
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-center gap-4 pt-2 sm:justify-between">
                <button
                  type="submit"
                  class="h-[52px] w-[210px] rounded-full border-[1.5px] border-[#1a9aa3] bg-gradient-to-b from-[#6fe6ee] to-bleu-vif font-pixel text-[1.375rem] text-blanc shadow-[0_3px_0_0_rgba(26,154,163,0.5)] transition hover:scale-[1.03] active:scale-[0.97]"
                >
                  envoyer &lt;3
                </button>
                <button
                  type="reset"
                  class="h-[52px] w-[210px] rounded-full border-[1.5px] border-rose-vif bg-gradient-to-b from-rose-pastel to-rose-vif font-pixel text-[1.375rem] text-noir shadow-[0_3px_0_0_rgba(0,0,0,0.18)] transition hover:scale-[1.03] active:scale-[0.97]"
                >
                  effacer :(
                </button>
              </div>

              <p id="statut-formulaire" role="status" class="min-h-[1.5em] text-center font-manrope text-[0.9375rem] text-marron"></p>
            </form>
          </div>

          <!-- Barre de statut -->
          <div class="flex items-center gap-2 px-2 pt-1 pb-0.5">
            <Image src={coeurStatut} alt="" class="size-3.5" />
            <span class="font-pixel text-[0.9375rem] text-marron">réponse sous 48h&nbsp;&nbsp;-&nbsp;&nbsp;disponible pour un stage</span>
          </div>
        </div>
      </div>

      <!-- ===== Colonne téléphone : mes réseaux (mockup complet, desktop uniquement) ===== -->
      <div class="relative hidden w-[260px] shrink-0 xl:block xl:w-[300px]">
        <Image
          src={porteClesCoeur}
          alt=""
          width={64}
          class="pointer-events-none absolute -top-10 right-6 hidden w-11 rotate-12 sm:block"
        />
        <Image
          src={refletPorteCles}
          alt=""
          width={14}
          class="pointer-events-none absolute -top-[22px] right-[46px] hidden w-2.5 -rotate-20 sm:block"
        />

        <div class="relative overflow-hidden rounded-[40px] border-3 border-white bg-gradient-to-b from-[#7fe3f2] to-[#b4f3de] p-[8px] shadow-card">
          <div class="relative overflow-hidden rounded-[32px] bg-white">
            <!-- Haut-parleur + caméra -->
            <div class="relative hidden items-center justify-center py-4 sm:flex">
              <span class="h-[6px] w-12 rounded bg-[#dcd5da]"></span>
              <Image src={camera} alt="" class="absolute right-[26%] size-2" />
            </div>

            <!-- Écran -->
            <div class="relative overflow-hidden bg-gradient-to-b from-[#ffe6f2] to-[#f8bcd9] px-4 pt-6 pb-6 sm:px-5 sm:pt-8 sm:pb-10">
              <Image src={motifPois} alt="" width={246} class="pointer-events-none absolute inset-0 size-full opacity-60" />
              <div class="relative flex flex-col items-center gap-5">
                <div class="flex w-full items-center justify-between">
                  <span class="font-pixel text-[0.875rem] font-semibold text-[#c2367f]">4G</span>
                  <Image src={batterie} alt="" class="h-3 w-[26px]" />
                </div>
                <p class="font-peix text-[1.75rem] text-marron [font-feature-settings:'liga'_0]">Mes réseaux</p>
                <p class="font-manrope text-[0.875rem] font-semibold text-[#8a5a6e]">Choisis ta ligne &lt;3</p>

                <ul class="mt-2 flex w-full flex-col items-center gap-4">
                  {reseaux.map(({ nom, href, externe }) => (
                    <li class="w-full">
                      <a
                        href={href}
                        target={externe ? "_blank" : undefined}
                        rel={externe ? "noopener" : undefined}
                        data-reseau
                        class="flex h-14 w-full items-center justify-between rounded-full border-[2.5px] border-[#f3a9c9] bg-gradient-to-b from-[#fffdf8] to-[#ffe6d9] px-4 shadow-[0_3px_0_0_rgba(216,138,176,0.6)] transition hover:scale-[1.03] active:scale-[0.97]"
                      >
                        <Image src={coeurBouton} alt="" class="size-[22px]" />
                        <span class="font-manrope text-[1rem] font-bold text-[#c2367f]">{nom}</span>
                        <Image src={coeurBouton} alt="" class="size-[22px]" />
                      </a>
                    </li>
                  ))}
                </ul>

                <p class="mt-2 font-pixel text-[0.875rem] text-[#c2367f]">- ligne ouverte 24h/24 -</p>
              </div>
            </div>

            <div class="hidden items-center justify-center py-5 sm:flex">
              <Image src={boutonHome} alt="" class="size-7" />
            </div>
          </div>
        </div>
      </div>
      </div>
    </main>
  </div>

  <Footer />
</Layout>

<script>
  // ===== Formulaire de contact : envoi direct du message dans PocketBase =====
  import { pb } from "../lib/pocketbase";

  const formulaire = document.querySelector<HTMLFormElement>("#formulaire-contact");
  const statut = document.querySelector<HTMLParagraphElement>("#statut-formulaire");
  const boutonEnvoyer = formulaire?.querySelector<HTMLButtonElement>('[type="submit"]');

  formulaire?.addEventListener("submit", async (evenement) => {
    evenement.preventDefault();
    if (!formulaire.reportValidity()) return;

    const donnees = new FormData(formulaire);

    // Honeypot : un champ normalement invisible, que seuls les bots remplissent.
    // On fait comme si l'envoi avait réussi, sans rien envoyer.
    if (String(donnees.get("piege") || "").trim()) {
      formulaire.reset();
      if (statut) statut.textContent = "Message envoyé, merci !";
      return;
    }

    boutonEnvoyer?.setAttribute("disabled", "true");
    if (statut) statut.textContent = "Envoi en cours…";

    try {
      await pb.collection("messages_contact").create({
        nom: String(donnees.get("nom") || "").trim(),
        email: String(donnees.get("email") || "").trim(),
        sujet: String(donnees.get("sujet") || "").trim(),
        message: String(donnees.get("message") || "").trim(),
      });
      formulaire.reset();
      if (statut) statut.textContent = "Message envoyé, merci ! Je reviens vers toi vite <3";
    } catch (erreur) {
      if (statut) statut.textContent = "Oups, l'envoi a échoué. Réessaie ou écris-moi directement par mail.";
      console.error(erreur);
    } finally {
      boutonEnvoyer?.removeAttribute("disabled");
    }
  });

  formulaire?.addEventListener("reset", () => {
    if (statut) statut.textContent = "";
  });

  // ===== Petits cœurs roses (GSAP) au survol des réseaux, façon reste du site =====
  import { gsap } from "gsap";

  const reduitAnimations = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const symboles = ["♥", "✦", "✧"];

  const exploser = (element: Element, nombre: number) => {
    const rect = element.getBoundingClientRect();
    const depart = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };

    for (let i = 0; i < nombre; i++) {
      const particule = document.createElement("span");
      particule.textContent = symboles[Math.floor(Math.random() * symboles.length)];
      particule.setAttribute("aria-hidden", "true");
      particule.style.cssText = `position:fixed;left:${depart.x}px;top:${depart.y}px;z-index:60;
        pointer-events:none;font-size:${14 + Math.random() * 12}px;color:var(--color-rose-vif);translate:-50% -50%;`;
      document.body.appendChild(particule);

      const angle = ((Math.random() * 90 - 45) * Math.PI) / 180;
      const distance = 60 + Math.random() * 55;
      const dx = Math.sin(angle) * distance;
      const dy = -Math.cos(angle) * distance - 25;
      const rotation = (Math.random() > 0.5 ? 1 : -1) * (40 + Math.random() * 80);
      const delai = i * 0.04;

      gsap
        .timeline({ delay: delai, onComplete: () => particule.remove() })
        .fromTo(particule, { scale: 0, opacity: 1 }, { scale: 1, duration: 0.25, ease: "back.out(3)" }, 0)
        .to(particule, { x: dx, rotation, duration: 0.8, ease: "power1.out" }, 0)
        .to(particule, { y: dy, duration: 0.8, ease: "power2.out" }, 0)
        .to(particule, { opacity: 0, duration: 0.3, ease: "power1.in" }, 0.5);
    }
  };

  if (!reduitAnimations) {
    document.querySelectorAll<HTMLAnchorElement>("[data-reseau]").forEach((lien) => {
      lien.addEventListener("pointerenter", () => exploser(lien, 4));
    });
  }
</script>
