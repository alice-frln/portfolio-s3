---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banniere from "../components/Banniere.astro";
---

<Layout title="Page introuvable — Alice Frelin">
  <Header />
  <Banniere titre="Oups" />
  <main class="mx-auto flex max-w-[1100px] flex-col items-start gap-8 px-6 py-20">
    <h2 class="text-section-title text-rose-vif">Page introuvable</h2>
    <p class="text-body-m">Cette page n'existe pas ou a été déplacée.</p>
    <a href="/projets" class="btn-pilule">Voir les projets</a>
  </main>
  <Footer />
</Layout>
