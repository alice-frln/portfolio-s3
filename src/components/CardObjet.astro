---
// Fenêtre (modal DaisyUI) qui s'ouvre quand on clique sur un objet de l'inventaire.
// Ouverture : document.getElementById("<id>").showModal()
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import croix from "../assets/img/bouton_croix_pixel.svg";

interface Props {
  id: string;
  titre: string;
  image: ImageMetadata;
  texte: string;
  /** Titre en 42px au lieu de 48px (pour les titres longs) */
  petitTitre?: boolean;
}

const { id, titre, image, texte, petitTitre = false } = Astro.props;
---

<dialog id={id} class="modal" aria-labelledby={`${id}-titre`}>
  <div
    class="modal-box relative h-auto w-[calc(100vw-2rem)] max-w-[441px] overflow-visible rounded-none border-6 border-primary
           bg-base-100 px-4 pt-1 pb-4 text-center shadow-card sm:h-[348px] sm:border-10 sm:px-5"
  >
    <form method="dialog">
      <button class="absolute top-2 right-2 size-12 cursor-pointer transition hover:scale-105 sm:size-[69px]" aria-label="Fermer">
        <Image src={croix} alt="" class="size-full" />
      </button>
    </form>

    <h2
      id={`${id}-titre`}
      class:list={[
        "px-10 font-peix leading-[1.4] whitespace-nowrap text-primary sm:px-16",
        petitTitre ? "text-[1.875rem] sm:text-[2.625rem]" : "text-[2.125rem] sm:text-[3rem]",
      ]}
    >
      {titre}
    </h2>

    <Image
      src={image}
      alt=""
      width={420}
      class="mx-auto h-[158px] w-[209px] object-contain [image-rendering:pixelated]"
    />

    <p class="mx-auto mt-2 max-w-[361px] font-manrope text-[1.375rem] leading-[1.358] text-base-content">
      {texte}
    </p>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>Fermer</button>
  </form>
</dialog>
