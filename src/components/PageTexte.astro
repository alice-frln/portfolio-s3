---
// Mise en page des pages de texte (mentions légales, politique de confidentialité)
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  titre: string;
}

const { titre } = Astro.props;
---

<Layout title={`${titre} — Alice Frelin`}>
  <Header />
  <main class="mx-auto max-w-[1100px] px-6 pt-16 pb-24 md:box-content md:px-12 md:pt-24">
    <h1 class="font-manrope text-[clamp(3rem,10.4vw,9.375rem)] leading-[1.05] font-extrabold tracking-[-0.07em] text-noir">
      {titre}
    </h1>
    <div
      class="mt-14 text-body-s md:mt-20
             [&_a]:underline [&_a]:hover:text-rose-vif
             [&_h2]:mt-16 [&_h2]:mb-6 [&_h2]:font-manrope [&_h2]:text-[2rem] [&_h2]:leading-tight [&_h2]:font-bold
             [&_h2]:tracking-[-0.07em] [&_h2]:first:mt-0 md:[&_h2]:text-[3.125rem]
             [&_p]:mb-2.5 [&_ul]:mb-2.5 [&_ul]:list-disc [&_ul]:pl-7"
    >
      <slot />
    </div>
  </main>
  <Footer />
</Layout>
