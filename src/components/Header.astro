---
import { Image } from "astro:assets";
import iconeAccueil from "../assets/svg/header_home_pixel.svg";
import iconeProjets from "../assets/svg/header_project_cup_pixel.svg";
import iconeAPropos from "../assets/svg/header_info_a_propos_pixel.svg";
import iconeContact from "../assets/svg/header_contact_telephone_pixel.svg";

// Page actuelle, sans le "/" final (sauf pour l'accueil)
const pageActuelle = Astro.url.pathname.replace(/(.)\/$/, "$1");

const liens = [
  { href: "/", label: "Accueil", icone: iconeAccueil },
  { href: "/projets", label: "Projets", icone: iconeProjets },
  { href: "/a-propos", label: "À propos", icone: iconeAPropos },
  { href: "/contact", label: "Contact", icone: iconeContact },
];
---

<header class="sticky top-0 z-50 flex h-[78px] w-full items-end justify-center px-4">
  <nav aria-label="Navigation principale">
    <ul class="flex items-end justify-center gap-1.5 sm:gap-10 lg:gap-24 xl:gap-[215px]">
      {liens.map(({ href, label, icone }) => (
        <li>
          <a href={href} class="btn-nav flex items-center gap-2" aria-current={pageActuelle === href ? "page" : undefined}>
            <Image src={icone} alt="" class="h-auto w-5 [image-rendering:pixelated]" />
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
