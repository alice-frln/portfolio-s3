---
import { Image } from "astro:assets";
import iconeAccueil from "../assets/svg/header_home_pixel.svg";
import iconeProjets from "../assets/svg/header_project_cup_pixel.svg";
import iconeAPropos from "../assets/svg/header_info_a_propos_pixel.svg";
import iconeContact from "../assets/svg/header_contact_telephone_pixel.svg";
import croix from "../assets/img/bouton_croix_pixel.svg";

// Page actuelle, sans le "/" final (sauf pour l'accueil)
const pageActuelle = Astro.url.pathname.replace(/(.)\/$/, "$1");

const liens = [
  { href: "/", label: "Accueil", icone: iconeAccueil },
  { href: "/projets", label: "Projets", icone: iconeProjets },
  { href: "/a-propos", label: "À propos", icone: iconeAPropos },
  { href: "/contact", label: "Contact", icone: iconeContact },
];
---

<header class="sticky top-0 z-50 flex h-[78px] w-full items-end justify-center px-4">
  <!-- Bouton hamburger : mobile uniquement -->
  <button
    type="button"
    id="bouton-menu-mobile"
    aria-label="Ouvrir le menu"
    aria-haspopup="dialog"
    aria-controls="menu-mobile"
    class="btn btn-circle size-[52px] border-2 border-noir bg-blanc md:hidden"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-6" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </button>

  <!-- Navigation complète : à partir de md -->
  <nav aria-label="Navigation principale" class="hidden md:block">
    <ul class="flex items-end justify-center gap-10 lg:gap-24 xl:gap-[215px]">
      {liens.map(({ href, label, icone }) => (
        <li>
          <a href={href} class="btn-nav flex items-center gap-2" aria-current={pageActuelle === href ? "page" : undefined}>
            <Image src={icone} alt="" class="h-auto w-5 [image-rendering:pixelated]" />
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<!-- Menu mobile : fenêtre plein écran ouverte par le bouton hamburger -->
<dialog id="menu-mobile" class="modal" aria-label="Menu de navigation">
  <div class="modal-box relative flex h-full max-h-none w-full max-w-none flex-col items-center justify-center gap-10 rounded-none border-0 bg-blanc py-16 shadow-none">
    <form method="dialog">
      <button aria-label="Fermer le menu" class="absolute top-4 right-4 cursor-pointer transition hover:scale-105">
        <Image src={croix} alt="" class="size-10" />
      </button>
    </form>

    <nav aria-label="Navigation mobile">
      <ul class="flex flex-col items-center gap-6">
        {liens.map(({ href, label, icone }) => (
          <li>
            <a
              href={href}
              class="btn-nav flex items-center gap-3 !text-[1.375rem]"
              aria-current={pageActuelle === href ? "page" : undefined}
            >
              <Image src={icone} alt="" class="h-auto w-7 [image-rendering:pixelated]" />
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>Fermer</button>
  </form>
</dialog>

<script>
  const boutonMenu = document.querySelector<HTMLButtonElement>("#bouton-menu-mobile");
  const menuMobile = document.querySelector<HTMLDialogElement>("#menu-mobile");

  boutonMenu?.addEventListener("click", () => menuMobile?.showModal());
</script>

<style>
  /* Le menu mobile occupe tout l'écran plutôt que d'être une petite fenêtre centrée */
  #menu-mobile {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
  }
</style>
