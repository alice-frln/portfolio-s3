---
import { Image } from "astro:assets";
import iconeAccueil from "../assets/svg/header_home_pixel.svg";
import iconeProjets from "../assets/svg/header_project_cup_pixel.svg";
import iconeAPropos from "../assets/svg/header_info_a_propos_pixel.svg";
import iconeContact from "../assets/svg/header_contact_telephone_pixel.svg";
import iconeHamburger from "../assets/svg/header_menu_hamburger.svg";
import iconeFermer from "../assets/svg/header_menu_fermer.svg";
import fondMenu from "../assets/img/apropos_background.webp";

// Page actuelle, sans le "/" final (sauf pour l'accueil)
const pageActuelle = Astro.url.pathname.replace(/(.)\/$/, "$1");

const liens = [
  { href: "/", label: "Accueil", icone: iconeAccueil },
  { href: "/projets", label: "Projets", icone: iconeProjets },
  { href: "/a-propos", label: "À propos", icone: iconeAPropos },
  { href: "/contact", label: "Contact", icone: iconeContact },
];
---

<header class="sticky top-0 z-50 flex h-[78px] w-full items-center justify-between px-5 md:items-end md:justify-center md:px-4">
  <!-- Mobile uniquement : nom du site + bouton hamburger -->
  <a href="/" class="font-manrope text-[1.5rem] font-extrabold tracking-[-0.05em] text-noir md:hidden">Alice</a>

  <button
    type="button"
    id="bouton-menu-mobile"
    aria-label="Ouvrir le menu"
    aria-haspopup="dialog"
    aria-controls="menu-mobile"
    class="flex size-10 shrink-0 items-center justify-center rounded-[20px] bg-rose-pastel transition hover:brightness-95 md:hidden"
  >
    <Image src={iconeHamburger} alt="" class="size-5" />
  </button>

  <!-- Navigation complète : à partir de md -->
  <nav aria-label="Navigation principale" class="hidden md:block">
    <ul class="flex items-end justify-center gap-10 lg:gap-24 xl:gap-[215px]">
      {liens.map(({ href, label, icone }) => (
        <li>
          <a href={href} class="btn-nav flex items-center gap-2" aria-current={pageActuelle === href ? "page" : undefined}>
            <Image src={icone} alt="" class="h-auto w-5 [image-rendering:pixelated]" />
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<!-- Menu mobile : tiroir qui glisse depuis la droite -->
<dialog id="menu-mobile" aria-label="Menu de navigation">
  <Image src={fondMenu} alt="" class="pointer-events-none absolute inset-0 -z-10 size-full object-cover" />

  <div class="relative flex h-full flex-col">
    <div class="flex items-center justify-end px-5 py-4">
      <form method="dialog">
        <button
          aria-label="Fermer le menu"
          class="flex size-10 items-center justify-center rounded-full bg-blanc/90 transition hover:scale-105"
        >
          <Image src={iconeFermer} alt="" class="size-4" />
        </button>
      </form>
    </div>

    <nav aria-label="Navigation mobile" class="flex flex-1 flex-col items-center justify-center gap-5 px-6 pb-20">
      <ul class="flex w-full flex-col items-center gap-5">
        {liens.map(({ href, label, icone }) => (
          <li class="w-full max-w-[260px]">
            <a
              href={href}
              class="btn-nav flex w-full items-center justify-center gap-3 !text-[1.25rem]"
              aria-current={pageActuelle === href ? "page" : undefined}
            >
              <Image src={icone} alt="" class="h-auto w-6 [image-rendering:pixelated]" />
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>Fermer</button>
  </form>
</dialog>

<script>
  const boutonMenu = document.querySelector<HTMLButtonElement>("#bouton-menu-mobile");
  const menuMobile = document.querySelector<HTMLDialogElement>("#menu-mobile");

  boutonMenu?.addEventListener("click", () => menuMobile?.showModal());

  // Ferme le tiroir après un clic sur un lien (navigation) pour éviter qu'il reste ouvert
  menuMobile?.querySelectorAll("a").forEach((lien) => lien.addEventListener("click", () => menuMobile.close()));
</script>
